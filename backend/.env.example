# Environment: local | staging | production
ENVIRONMENT=local

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (provider-agnostic abstraction; groq is the only implemented adapter today)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Safety: hard deterministic floor below which recommendation-stage agents
# (Career Intelligence, Decision, Roadmap) are never routed to, regardless of
# what the orchestrator LLM decides.
MIN_RECOMMENDATION_CONFIDENCE=0.6

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
